# Runs the Flask app permanently via Gunicorn, restarting it automatically if
# it ever crashes or the server reboots. Install with:
#   sudo cp deploy/electronics-service-crm.service /etc/systemd/system/
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now electronics-service-crm
#
# Check status any time with: sudo systemctl status electronics-service-crm
# View logs with:             sudo journalctl -u electronics-service-crm -f

[Unit]
Description=Electronics Service Center CRM (Gunicorn)
After=network.target mysql.service

[Service]
Type=simple
User=ubuntu
Group=ubuntu
WorkingDirectory=/home/ubuntu/electronics-service-crm
EnvironmentFile=/home/ubuntu/electronics-service-crm/.env
ExecStart=/home/ubuntu/electronics-service-crm/venv/bin/gunicorn \
    --workers 3 \
    --bind 127.0.0.1:8000 \
    --access-logfile /home/ubuntu/electronics-service-crm/logs/access.log \
    --error-logfile /home/ubuntu/electronics-service-crm/logs/error.log \
    run:app
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
